  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  uploadedBy String?
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Goal {
