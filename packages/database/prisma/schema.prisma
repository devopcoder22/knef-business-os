  @@index([planId])
}

model PlanTaskLink {
  id           String   @id @default(cuid())
  planId       String
  stepId       String?
  taskId       String?  // null while proposed; set after execution
  isProposed   Boolean  @default(true)
  proposedData Json?    // task fields for proposed tasks
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plan Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  step PlanStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([taskId])
}

model PlanTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  type           PlanType @default(BUSINESS)
  structure      Json     // steps, task templates, KPI templates
  isActive       Boolean  @default(true)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plans Plan[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model AITool {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  description      String
  inputSchema      Json
  isActive         Boolean  @default(true)
  requiresApproval Boolean  @default(false)
  category         String?
  riskLevel        String   @default("LOW")
  externalExposure String   @default("NOT_EXPOSED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  actions AIAction[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([externalExposure])
}

enum AutonomyLevel {
  ADVISORY
  DRAFT
  APPROVAL_REQUIRED
  LIMITED_AUTONOMY
  SCHEDULED_AUTONOMY
}

model AiAutonomyPolicy {
  id             String        @id @default(cuid())
  organizationId String
  scope          String
  scopeId        String?
  level          AutonomyLevel @default(APPROVAL_REQUIRED)
  scopeLimits    Json          @default("{}")
  isActive       Boolean       @default(true)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, scope, scopeId])
  @@index([organizationId])
}

model ExternalAgent {
  id                 String    @id @default(cuid())
  organizationId     String
  name               String
  description        String?
  ownerId            String?
  status             String    @default("ACTIVE")
  scopes             String[]
  allowedTools       String[]
  autonomyLevel      String    @default("APPROVAL_REQUIRED")
  rateLimitPerMinute Int       @default(60)
  apiKeyId           String?
  metadata           Json?
  lastUsedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId])
  @@index([apiKeyId])
  @@unique([organizationId, name])
}

model AIAction {
  id              String       @id @default(cuid())
  organizationId  String
  toolId          String?
  conversationId  String?
  userId          String?
  externalAgentId String?
  requestId       String?
  action          String
  parameters      Json
  result          Json?
  status          ActionStatus @default(PENDING)
  approvalId      String?
  executedAt      DateTime?
  autonomyLevel   String?
  policyDecision  String?
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())

  tool AITool? @relation(fields: [toolId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([externalAgentId])
  @@index([requestId])
}

enum ActionStatus {
  PENDING
  APPROVED
  EXECUTING
  COMPLETED
  FAILED
  REJECTED
}

model AIApproval {
  id             String   @id @default(cuid())
  organizationId String
  actionId       String?
  requestedBy    String?
  reviewedBy     String?
  decision       String?
  reason         String?
  expiresAt      DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([decision])
}

model AIScheduledAgent {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  taskType       String
  parameters     Json
  cronExpression String
  isActive       Boolean  @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  lastStatus     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isActive])
}

model AIUsageLog {
  id             String   @id @default(cuid())
  organizationId String
  providerId     String?
  userId         String?
  model          String
  taskType       String?
  promptTokens   Int      @default(0)
  completionTokens Int    @default(0)
  totalTokens    Int      @default(0)
  costUsd        Decimal  @db.Decimal(10, 6) @default(0)
  latencyMs      Int?
  createdAt      DateTime @default(now())

  provider AIProvider? @relation(fields: [providerId], references: [id])

  @@index([organizationId])
  @@index([providerId])
  @@index([createdAt])
}

model AIBudget {
  id             String   @id @default(cuid())
  organizationId String
  providerId     String?
  period         String
  limitUsd       Decimal  @db.Decimal(10, 2)
  spentUsd       Decimal  @db.Decimal(10, 6) @default(0)
  alertAt        Decimal  @db.Decimal(5, 2) @default(80)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider AIProvider? @relation(fields: [providerId], references: [id])

  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────
// COMMUNICATIONS MODELS
// ─────────────────────────────────────────────────────────────

model EmailProvider {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  type           String
  host           String?
  port           Int?
  secure         Boolean  @default(false)
  username       String?
  passwordEncrypted String?
  apiKeyEncrypted String?
  fromEmail      String
  fromName       String
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaigns EmailCampaign[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model EmailCampaign {
  id              String         @id @default(cuid())
  organizationId  String
  providerId      String?
  name            String
  subject         String
  previewText     String?
  fromEmail       String?
  fromName        String?
  replyTo         String?
  htmlContent     String?
  textContent     String?
  campaignType    String         @default("MARKETING")
  subscriptionList String        @default("GENERAL_MARKETING")
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdById     String?
  reviewedBy      String?
  reviewedAt      DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  totalRecipients Int            @default(0)
  eligibleCount   Int            @default(0)
  suppressedCount Int            @default(0)
  sentCount       Int            @default(0)
  deliveredCount  Int            @default(0)
  openCount       Int            @default(0)
  clickCount      Int            @default(0)
  bounceCount     Int            @default(0)
  complainedCount Int            @default(0)
  failedCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  provider   EmailProvider?           @relation(fields: [providerId], references: [id])
  recipients EmailCampaignRecipient[]

  @@index([organizationId])
  @@index([status])
  @@index([campaignType])
}

enum CampaignStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
  FAILED
}

model EmailCampaignRecipient {
  id                String    @id @default(cuid())
  campaignId        String
  email             String
  name              String?
  status            String    @default("PENDING")
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  failedAt          DateTime?
  complainedAt      DateTime?
  errorMessage      String?
  metadata          Json?

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId])
}

model EmailSubscription {
  id               String    @id @default(cuid())
  organizationId   String
  email            String
  customerId       String?
  subscriptionList String    @default("GENERAL_MARKETING")
  status           String    @default("SUBSCRIBED")
  source           String?
  consentAt        DateTime?
  unsubscribedAt   DateTime?
  suppressedAt     DateTime?
  suppressionReason String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([organizationId, email, subscriptionList])
  @@index([organizationId])
  @@index([email])
  @@index([status])
}

model CommunicationTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  type           String
  subject        String?
  body           String
  variables      Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, name, type])
  @@index([organizationId])
  @@index([type])
}

model TelegramConfig {
  id                String   @id @default(cuid())
  organizationId    String   @unique
  botTokenEncrypted String
  chatId            String?
  username          String?
  webhookSecret     String?
  isActive          Boolean  @default(true)
  notifyOrders      Boolean  @default(true)
  notifyInventory   Boolean  @default(true)
  notifyFinance     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
}

model TelegramUserLink {
  id               String    @id @default(cuid())
  organizationId   String
  userId           String
  telegramId       String
  telegramUsername String?
  telegramChatId   String?
  isVerified       Boolean   @default(false)
  verifiedAt       DateTime?
  notifyOrders     Boolean   @default(true)
  notifyInventory  Boolean   @default(true)
  notifyFinance    Boolean   @default(false)
  notifyTasks      Boolean   @default(true)
  notifyLowStock   Boolean   @default(true)
  notifyTargets    Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@unique([organizationId, userId])
  @@unique([organizationId, telegramId])
  @@index([organizationId])
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType
  title          String
  body           String
  data           Json?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  channel        String           @default("in_app")
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

// ─────────────────────────────────────────────────────────────
// SYSTEM MODELS
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action])
}

model APIKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String    @unique
  prefix         String
  scopes         String[]  @default([])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdBy      String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyHash])
}

model FeatureFlag {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  name           String
  description    String?
  isEnabled      Boolean  @default(false)
  rolloutPercent Int      @default(0)
  metadata       Json?
  updatedBy      String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model UserFeatureFlag {
  id         String   @id @default(cuid())
  userId     String
  featureKey String
  state      String   @default("INHERIT")
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey])
  @@index([userId])
}

model SystemSetting {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          String
  type           String   @default("string")
  group          String?
  label          String?
  description    String?
  isPublic       Boolean  @default(false)
  updatedBy      String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([group])
}

model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  name           String
  events         String[] @default([])
  secretHash     String
  isActive       Boolean  @default(true)
  failureCount   Int      @default(0)
  lastTriggeredAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  endpointId  String
  event       String
  payload     Json
  status      String   @default("PENDING")
  responseCode Int?
  responseBody String?
  attempts    Int      @default(0)
  nextRetryAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([status])
}

model AutomationRule {
  id              String   @id @default(cuid())
  organizationId  String
  locationId      String?
  name            String
  description     String?
  trigger         String
  conditions      Json     @default("[]")
  actions         Json     @default("[]")
  isActive        Boolean  @default(true)
  lastTriggeredAt DateTime?
  triggerCount    Int      @default(0)
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  executions AutomationExecution[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([trigger])
  @@index([locationId])
}

model AutomationExecution {
  id              String    @id @default(cuid())
  organizationId  String
  ruleId          String
  eventId         String
  eventType       String
  locationId      String?
  status          String    @default("PENDING")
  actionType      String
  actionIndex     Int       @default(0)
  causationId     String?
  automationDepth Int       @default(0)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  attempt         Int       @default(0)
  failureCategory String?
  errorMessage    String?
  resultMetadata  Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, eventId, actionIndex])
  @@index([organizationId])
  @@index([ruleId])
  @@index([eventId])
  @@index([status])
}

model CalendarIntegration {
  id                   String   @id @default(cuid())
  organizationId       String
  userId               String
  provider             String
  accessTokenEncrypted String?
  refreshTokenEncrypted String?
  expiresAt            DateTime?
  calendarId           String?
  calendarName         String?
  scope                String?
  syncToken            String?
  isActive             Boolean  @default(true)
  syncEnabled          Boolean  @default(true)
  lastSyncAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  events CalendarEvent[]

  @@unique([organizationId, userId, provider])
  @@index([organizationId])
  @@index([userId])
}

model CalendarEvent {
  id                 String   @id @default(cuid())
  organizationId     String
  userId             String
  integrationId      String
  externalEventId    String
  externalCalendarId String
  provider           String
  title              String
  description        String?
  location           String?
  startAt            DateTime
  endAt              DateTime
  timezone           String   @default("UTC")
  isAllDay           Boolean  @default(false)
  status             String   @default("confirmed")
  attendees          Json?
  recurrence         Json?
  reminders          Json?
  htmlLink           String?
  syncedAt           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  integration CalendarIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalEventId])
  @@index([organizationId])
  @@index([userId])
  @@index([startAt])
  @@index([integrationId])
}

model Integration {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  name           String
  config         Json     @default("{}")
  secretsEncrypted Json?
  isActive       Boolean  @default(true)
  lastSyncAt     DateTime?
  syncStatus     String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, type])
  @@index([organizationId])
}
