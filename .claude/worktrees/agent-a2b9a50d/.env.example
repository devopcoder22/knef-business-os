# ============================================================
# KNEF Business OS — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to git
# ============================================================

# ─── APPLICATION ─────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://yourdomain.com
API_PORT=4000
WEB_PORT=3000

# ─── SECURITY ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Generate with: openssl rand -hex 32
# Used to encrypt AI API keys, SMTP passwords, OAuth tokens stored in DB
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX

# ─── DATABASE ─────────────────────────────────────────────────
DATABASE_URL=postgresql://knef:REPLACE_PASSWORD@db:5432/knef_prod
DB_PASSWORD=REPLACE_PASSWORD

# ─── REDIS ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── AI PROVIDERS ────────────────────────────────────────────
# At least one provider required for AI features
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=

# ─── PAYMENTS ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# ─── EMAIL (default SMTP) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@knefgadgets.com
SMTP_FROM_NAME=KNEF Gadgets

# ─── BANKING (optional) ──────────────────────────────────────
MONO_SECRET_KEY=
OKRA_SECRET_KEY=

# ─── TELEGRAM ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── STORAGE ──────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# ─── BACKUP ───────────────────────────────────────────────────
BACKUP_DIR=/app/backups
BACKUP_ENCRYPTION_PASSPHRASE=REPLACE_WITH_STRONG_PASSPHRASE

# ─── FEATURE FLAGS (override DB defaults) ────────────────────
# These are initial defaults — managed in the admin panel after first login
FEATURE_AI_ASSISTANT=false
FEATURE_BANK_INTEGRATION=false
FEATURE_MARKETPLACE_SYNC=false
FEATURE_EMAIL_MARKETING=false
FEATURE_TELEGRAM=false
FEATURE_CALENDAR=false
FEATURE_MULTI_LOCATION=false
