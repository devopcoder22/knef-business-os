# KNEF Storefront — environment variables
# Copy to .env.local and fill in real values
# IMPORTANT: Variables prefixed NEXT_PUBLIC_ are visible in browser JS.
#            Keep secrets in server-only vars (no NEXT_PUBLIC_ prefix).

# ── Server-only (never exposed to browser) ───────────────────────────────────

# Internal URL of the KNEF Business OS API (used by BFF route handlers)
STOREFRONT_BACKEND_URL=http://localhost:4000
# Same value used when calling from within Docker network
STOREFRONT_INTERNAL_URL=http://api:4000

# API key with scopes: products:read, inventory:read, sales:write, sales:read
# Generate this in Business OS admin → E-commerce → API Keys
STOREFRONT_API_KEY=knef_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Organization ID to scope all storefront operations to
STOREFRONT_ORG_ID=

# Default location ID for stock checks and order placement
STOREFRONT_ORG_LOCATION_ID=

# JWT secret — must match the API's JWT_SECRET for customer token verification
JWT_SECRET=

# ── Public (safe to expose to browser) ───────────────────────────────────────

# Store display name shown in the header/title
NEXT_PUBLIC_STORE_NAME=KNEF Gadgets

# Currency code (matches API)
NEXT_PUBLIC_CURRENCY=NGN
