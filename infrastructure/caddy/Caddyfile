# KNEF Business OS — Caddy reverse proxy configuration

# Customer storefront — knefgadgets.com
knefgadgets.com {
    # BFF route handlers (server actions, proxied to api internally)
    handle /api/* {
        reverse_proxy storefront:3001 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # All other storefront pages
    handle {
        reverse_proxy storefront:3001 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "frame-ancestors 'none'"
        -Server
    }

    # Logging
    log {
        output file /var/log/caddy/storefront-access.log {
            roll_size 100mb
            roll_keep 10
        }
        format json
    }
}

# Admin/staff Next.js + API — knefos.knefgadgets.com
knefos.knefgadgets.com {
    # API routes
    handle /api/* {
        reverse_proxy api:4000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Health check
    handle /health {
        reverse_proxy api:4000
    }

    # Uploaded files served by API
    handle /uploads/* {
        reverse_proxy api:4000
    }

    # Everything else goes to the staff Next.js app
    handle {
        reverse_proxy web:3000 {
            header_up X-Real-IP {remote_host}
        }
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "frame-ancestors 'none'"
        -Server
    }

    # Logging
    log {
        output file /var/log/caddy/admin-access.log {
            roll_size 100mb
            roll_keep 10
        }
        format json
    }
}

# Fallback: plain HTTP for IP-only access (stage-validation / direct IP health-checks)
# Named domains redirect to HTTPS via Caddy automatic TLS; this :80 handler
# only serves internal health-check routes that must remain accessible without TLS.
:80 {
    handle /api/health* {
        reverse_proxy api:4000
    }

    handle /health {
        reverse_proxy api:4000
    }

    # All other HTTP traffic gets a permanent redirect to HTTPS
    handle {
        redir https://{host}{uri} permanent
    }
}

# Storefront: IP-based access on port 8080
:8080 {
    handle /api/* {
        reverse_proxy storefront:3001
    }

    handle {
        reverse_proxy storefront:3001
    }
}
